#!/bin/bash
set -Eeuo pipefail

# NOTE: adding / removing the variables / modifying the name of variables is not allowed in this script

# Available local variables:
#  - variables defined in custom_build
#  - ${target_root_prefix_without_pkgname}: ${target_root_with_pkgname} is the output directory generated by the building process. i.e. the staging area for this package manager. Now ${target_root_prefix_without_pkgname}.<pkgname> == ${target_root_with_pkgname}
#  - ${sources_root}: the suggested root directory of the source directory
setup() {

# TODO: please fill in the variables for this package

# [REQUIRED, NON-EMPTY, SEMVER]
pkg_version="1.78.1"
# [REQUIRED, NON-EMPTY, NO-SPACE]
pkg_name="grpc"
# [OPTIONAL, seperated by commas, NO-SPACE]. e.g., pkgname1>=0.5,pkgname2==1.0.0,pkgname2<2.0.0,pkgname3
pkg_deps="libz>=1.0,openssl>=3.0"
# [OPTIONAL, seperated by commas, NO-SPACE]
# NOTE: you need to add build deps "python3,python3-build,python3-setuptools" if you use setup_pycrossenv in hooks
pkg_build_deps="libz>=1.0,openssl>=3.0,python3>=3.9,python3-build,python3-setuptools,python3-wheel,python3-cython,python3-typing-extensions>=4.12,<5,python3-protobuf>=6.31.1,<7.0.0"
########### At Least ONE is REQUIRED ##############
# [OPTIONAL, VALID-URL]
pkg_source_url="https://github.com/grpc/grpc"
# [OPTIONAL, VALID-URL]
pkg_release_url=""
###################################################
pkg_license="Apache-2.0"
# [REQUIRED, NON-EMPTY, seperated by commas, NO-SPACE]. e.g., x86_64,aarch64,arm,riscv
pkg_support_archs="x86_64,aarch64,arm"
# [REQUIED, NON-EMPTY]
# choose one: "autotools" (configure and make), "cmake", "meson", "pure-python", "custom"
# NOTE:
#  - "pure-python" is ONLY valid for those packages without ANY native package dependency.
#  - "custom" will skip the default build process
#  - add "python3,python3-build,python3-wheel,python3-setuptools" to pkg_build_deps if you use "pure-python"
#  - you may need to use setup_pycrossenv if you set pkg_build_type == "meson"
pkg_build_type="cmake"
# [OPTIONAL]
pkg_build_parallism="20"
# [OPTIONAL: empty or Y]
pkg_force_clean_build=""
# [OPTIONAL, separated by commas, NO-SPACE]. Relative paths are resolved from this package directory, then repo root.
pkg_patch_files="patches/${pkg_version}/0001-add-openharmony-platform-support.patch"

####### build type related (all OPTIONAL) #######

pkg_build_autotools_extra_configure_flags=""
# fill in a relative path to the ${current_source_root} (defined below)
pkg_build_autotools_bootstrap_script=""
pkg_build_autotools_suffix_configure_flags=""
pkg_build_autotools_configure_dir=""
pkg_build_autotools_make_install_target=""

pkg_build_cmake_extra_cmake_flags="-DCMAKE_POLICY_VERSION_MINIMUM=3.5 -DOHOS_ALLOW_UNDEFINED_SYMBOLS=ON -DCMAKE_BUILD_TYPE=Release -DCMAKE_POSITION_INDEPENDENT_CODE=ON -DCMAKE_CXX_STANDARD=17 -DABSL_PROPAGATE_CXX_STD=ON -DgRPC_ZLIB_PROVIDER=package -DgRPC_SSL_PROVIDER=package -DgRPC_INSTALL=ON -DgRPC_INSTALL_LIBDIR=${OHOS_LIBDIR} -DgRPC_INSTALL_CMAKEDIR=${OHOS_LIBDIR}/cmake/grpc"
pkg_build_cmake_extra_cmake_prefix_path=""
pkg_build_cmake_extra_cflags=""
# NOTE: C preprocessor not CXX
pkg_build_cmake_extra_cppflags=""
pkg_build_cmake_extra_ldflags="-Wl,--allow-shlib-undefined -Wl,-undefined,dynamic_lookup"
pkg_build_cmake_extra_cmake_findroot_path=""

# fill in a absolute path
pkg_build_meson_cross_file=""
pkg_build_meson_extra_meson_flags=""
pkg_build_meson_extra_cflags=""
pkg_build_meson_extra_ldflags=""
pkg_build_meson_extra_cmake_prefix_path=""
pkg_build_meson_extra_cmake_findroot_path=""

}


################# Hooks #################
# NOTE:
#  1. not using relative path in hooks
#  2. not using $PWD, pwd, cd here. You can ONLY use pushd to change your working directory and you are responsible to use popd to restore the old one before the hook returns
#  3. not creating global variables in hooks (except for `custom_build`)
#  4. global config variables (capitalized) in setup.sh (like OHOS_LIBDIR, OHOS_CPU, ...) is available in hooks
#  5. important cross-compiling variables will be reset after building each package (like CFLAGS, CXXFLAGS, LDFLAGS, CC, CXX, AR, PKG_CONFIG_LIBDIR, ...)
#  6. you can use helper functions in setup.sh
#  7. you can define your own function here but you can only use it for this package. If you want to define a function for building process of multiple packages, you should modify the setup.sh
#  8. you are responsible to handle all the failures in hooks (commands may continue if you not deal with it)
# 
# Available global variables:
#  - ${native_project_root}: the parent directory of setup.sh
#  - ${native_sources_root}: root for native sources (staging area)
#  - cross-compiling variables (reset for each package): CC, CXX, AR, CFLAGS, PKG_CONFIG_*, ...
#  - global configurations: OHOS_ARCH, OHOS_CPU, OHOS_LIBDIR, PATCH_FILE_ROOT, MESON_CROSS_ROOT, HOST_SYSROOT, ... (see setup.sh)
# Available local variables (except for native_env_hook):
#  - ${current_source_url}: user configured `pkg_source_url` above (in `setup()`)
#  - ${current}: the location (directory) of this script
#  - ${sources_root}: the suggested root directory of the source directory
#  - ${current_source_root}: the current source directory to be compiled
#  - ${target_root_with_pkgname}: output directory generated by the building process. i.e. the staging area for this package manager
#  - ${target_root_prefix_without_pkgname}: Now ${target_root_prefix_without_pkgname}.<pkgname> == ${target_root_with_pkgname}
#########################################

# Hook: called before setup.sh is sourced
# NOTE:
#  - failure in this function will terminate this script immediately
#  - you can NOT use local variables defined above. you can only use ${native_project_root}, ${native_sources_root}, ${native_dst_root} built by builder.sh
native_env_hook() {
	# first build on host machine (for gRPC CPP plugin)

	# temporary setup for pkg info (need random ${OHOS_LIBDIR} for flags. We will override it in builder.sh)
	OHOS_LIBDIR=lib setup

	local grpc_native_src_root=$(get_native_src_root $pkg_name)

	# check if grpc_*_plugin (if any) and protoc exist in ${native_dst_root}/bin
	local required_binaries=(
        "${native_dst_root}/bin/protoc"
        "${native_dst_root}/bin/grpc_cpp_plugin"
        "${native_dst_root}/bin/grpc_python_plugin"
    )
	local all_exist=true
	local bin
    for bin in "${required_binaries[@]}"; do
        if [ ! -f "$bin" ]; then
            all_exist=false
            break
        fi
    done
	if [ "x$all_exist" = "xtrue" ]; then
        info "gRPC native binaries found in ${native_dst_root}/bin, skipping native build..."
        return 0
    fi

	if [ ! -d "${grpc_native_src_root}" ]; then
		mkdir -p "${grpc_native_src_root}" || return 1
		git clone -b "v${pkg_version}" "${pkg_source_url}" "${grpc_native_src_root}" || return 1
		pushd "${grpc_native_src_root}" >/dev/null || return 1
		git submodule update --init || { popd >/dev/null; return 1; }
		pushd third_party/protobuf >/dev/null || { popd >/dev/null; return 1; }
		git checkout v33.5 || { popd >/dev/null; popd >/dev/null; return 1; }
		popd >/dev/null || return 1
		verify_grpc_submodules || { popd >/dev/null; return 1; }
		popd >/dev/null || return 1
	fi

	cmake -DCMAKE_VERBOSE_MAKEFILE=ON \
		-DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
		-DgRPC_BUILD_TESTS=OFF \
		-DCMAKE_CXX_STANDARD=17 \
		-B ${grpc_native_src_root}/native-build -S ${grpc_native_src_root}
	cmake --build ${grpc_native_src_root}/native-build --config Release -- -j20
	
	# copy to ${native_dst_root}
	mkdir -p ${native_dst_root}/bin
	cp -P ${grpc_native_src_root}/native-build/grpc_*_plugin \
		${grpc_native_src_root}/native-build/third_party/protobuf/protoc* \
		${native_dst_root}/bin
		#${grpc_native_src_root}/native-build/third_party/cares/cares/bin/* \
}

# Hook: customize downloading source process. called when pacakge manager is downloading the source.
# 	Set _custom_download_source_continue to "true" (default) to continue normal downloading process after return, otherwise not.
# NOTE: you need to make sure the source locates in ${current_source_root}
# 	if you set _custom_download_source_continue="false" caz default build process will use
custom_download_source() {

	if [ ! -d "${current_source_root}" ]; then
		mkdir -p "${current_source_root}" || return 1
		git clone -b "v${pkg_version}" "${pkg_source_url}" "${current_source_root}" || return 1
		pushd "${current_source_root}" >/dev/null || return 1
		git submodule update --init || { popd >/dev/null; return 1; }
		pushd third_party/protobuf >/dev/null || { popd >/dev/null; return 1; }
		git checkout v33.5 || { popd >/dev/null; popd >/dev/null; return 1; }
		popd >/dev/null || return 1
		verify_grpc_submodules || { popd >/dev/null; return 1; }
		popd >/dev/null || return 1
	fi

	_custom_download_source_continue=false
}

verify_grpc_submodules() {
	local missing=0
	local required_path
	local required_paths=(
		"third_party/abseil-cpp/CMakeLists.txt"
		"third_party/cares/cares/CMakeLists.txt"
		"third_party/protobuf/CMakeLists.txt"
		"third_party/re2/CMakeLists.txt"
		"third_party/zlib/CMakeLists.txt"
	)

	for required_path in "${required_paths[@]}"; do
		if [ ! -f "$required_path" ]; then
			error "grpc submodule is incomplete: ${required_path}"
			missing=1
		fi
	done
	return "$missing"
}

############### DO NOT MODIFY THIS PART #################
if [ "x${LOAD_NATIVE_HOOK_ONLY:-}" = "xtrue" ]; then
	return 0
fi
#########################################################

# Hook: called before entering build dir
prebuilt_patch_hook() {
	:
}

# Hook: same as `prebuilt_patch_hook` but executed once if the source directory is not changed (mark file PATCHED)
# NOTE: it will be executed BEFORE prebuilt_patch_hook
prebuilt_patch_once_hook() {
	apply_pkg_git_patches
	patch_grpc_python_cares_config_for_ohos
}

# Hook: customize building process.
# 	Set _custom_build_continue to "true" (default) to continue normal building process after return, otherwise not.
# NOTE:
#  - You can set cross-compiling related global variables here (like CFLAGS)
#  - postbuilt_hook will still be called after custom_build set _custom_build_continue="false"
custom_build() {
	_custom_build_continue=true
}

# Hook: called after leaving build dir (staging area ${target_root_with_pkgname} is generated)
postbuilt_hook() {
	build_grpc_python_wheels
}

################ self-defined functions (local) goes below ################

build_grpc_python_wheels() {
	local build_rc=0
	local wheel_root="${target_root_with_pkgname}/python-wheels"
	local grpcio_wheel_dir="${current_work_root}/wheels/grpc-python/grpcio"
	local grpcio_tools_wheel_dir="${current_work_root}/wheels/grpc-python/grpcio-tools"
	local openssl_prefix
	local saved_cflags="${CFLAGS:-}"
	local saved_cxxflags="${CXXFLAGS:-}"
	local saved_ldflags="${LDFLAGS:-}"
	local saved_grpc_python_cflags="${GRPC_PYTHON_CFLAGS:-}"
	local saved_grpc_python_ldflags="${GRPC_PYTHON_LDFLAGS:-}"
	local saved_grpc_python_build_system_openssl="${GRPC_PYTHON_BUILD_SYSTEM_OPENSSL:-}"
	local saved_grpc_python_build_with_cython="${GRPC_PYTHON_BUILD_WITH_CYTHON:-}"

	openssl_prefix=$(get_pkg_dst_dir openssl) || return 1
	rm -rf "$wheel_root" "$grpcio_wheel_dir" "$grpcio_tools_wheel_dir"
	mkdir -p "$wheel_root" "$grpcio_wheel_dir" "$grpcio_tools_wheel_dir" || return 1

	setup_pycrossenv || return 1
	"${PYCROSS_BUILD_PIP}" install "cython==3.1.1" || build_rc=$?

	if [ "$build_rc" -eq 0 ]; then
		export GRPC_PYTHON_BUILD_SYSTEM_OPENSSL=1
		export GRPC_PYTHON_BUILD_WITH_CYTHON=1
		CFLAGS="-I${openssl_prefix}/include ${CFLAGS:-}"
		CXXFLAGS="-I${openssl_prefix}/include ${CXXFLAGS:-}"
		export GRPC_PYTHON_CFLAGS="-std=c++17 -fno-wrapv -frtti -O1 -DEVP_MD_CTX_create=EVP_MD_CTX_new -DEVP_MD_CTX_destroy=EVP_MD_CTX_free -I${openssl_prefix}/include ${CFLAGS:-}"
		export GRPC_PYTHON_LDFLAGS="-L${openssl_prefix}/${OHOS_LIBDIR} ${LDFLAGS:-} -lssl -lcrypto"

		pushd "${current_source_root}" >/dev/null || build_rc=$?
		if [ "$build_rc" -eq 0 ]; then
			"${PYCROSS_CROSS_PIP}" wheel \
				--wheel-dir "$grpcio_wheel_dir" \
				-v --no-deps --no-build-isolation --no-binary :all: . || build_rc=$?
			popd >/dev/null || {
				[ "$build_rc" -eq 0 ] && build_rc=1
			}
		fi
	fi

	if [ "$build_rc" -eq 0 ]; then
		pushd "${current_source_root}/tools/distrib/python/grpcio_tools" >/dev/null || build_rc=$?
		if [ "$build_rc" -eq 0 ]; then
			prepare_grpcio_tools_sources_without_bazel || build_rc=$?
			if [ "$build_rc" -eq 0 ]; then
				"${PYCROSS_CROSS_PIP}" wheel \
					--wheel-dir "$grpcio_tools_wheel_dir" \
					-v --no-deps --no-build-isolation --no-binary :all: . || build_rc=$?
			fi
			popd >/dev/null || {
				[ "$build_rc" -eq 0 ] && build_rc=1
			}
		fi
	fi

	if [ "$build_rc" -eq 0 ]; then
		cp -f "$grpcio_wheel_dir"/*.whl "$wheel_root/" || build_rc=$?
	fi
	if [ "$build_rc" -eq 0 ]; then
		cp -f "$grpcio_tools_wheel_dir"/*.whl "$wheel_root/" || build_rc=$?
	fi
	if [ "$build_rc" -eq 0 ]; then
		archive_python_wheels "$wheel_root" || build_rc=$?
	fi

	CFLAGS="$saved_cflags"
	CXXFLAGS="$saved_cxxflags"
	LDFLAGS="$saved_ldflags"
	export GRPC_PYTHON_CFLAGS="$saved_grpc_python_cflags"
	export GRPC_PYTHON_LDFLAGS="$saved_grpc_python_ldflags"
	export GRPC_PYTHON_BUILD_SYSTEM_OPENSSL="$saved_grpc_python_build_system_openssl"
	export GRPC_PYTHON_BUILD_WITH_CYTHON="$saved_grpc_python_build_with_cython"
	destroy_pycrossenv || {
		[ "$build_rc" -eq 0 ] && build_rc=1
	}

	return "$build_rc"
}

patch_grpc_python_cares_config_for_ohos() {
	local ares_config="${current_source_root}/third_party/cares/config_linux/ares_config.h"

	[ -f "$ares_config" ] || { error "missing c-ares Linux config: ${ares_config}"; return 1; }
	sed -i 's|^#define HAVE_GETSERVBYPORT_R$|/* #undef HAVE_GETSERVBYPORT_R */|' "$ares_config"
}

prepare_grpcio_tools_sources_without_bazel() {
	local grpc_tools_root="${current_source_root}/tools/distrib/python/grpcio_tools"

	rm -rf \
		"${grpc_tools_root}/grpc_root" \
		"${grpc_tools_root}/third_party/abseil-cpp" \
		"${grpc_tools_root}/third_party/protobuf"

	mkdir -p \
		"${grpc_tools_root}/grpc_root" \
		"${grpc_tools_root}/third_party/abseil-cpp" \
		"${grpc_tools_root}/third_party/protobuf" || return 1

	cp -a "${current_source_root}/include" "${grpc_tools_root}/grpc_root/" || return 1
	mkdir -p "${grpc_tools_root}/grpc_root/src" || return 1
	cp -a "${current_source_root}/src/compiler" "${grpc_tools_root}/grpc_root/src/" || return 1
	cp -a "${current_source_root}/third_party/abseil-cpp/absl" "${grpc_tools_root}/third_party/abseil-cpp/" || return 1
	cp -a "${current_source_root}/third_party/protobuf/src" "${grpc_tools_root}/third_party/protobuf/" || return 1
	cp -a "${current_source_root}/third_party/protobuf/upb" "${grpc_tools_root}/third_party/protobuf/" || return 1
	cp -a "${current_source_root}/third_party/protobuf/upb_generator" "${grpc_tools_root}/third_party/protobuf/" || return 1
	mkdir -p "${grpc_tools_root}/third_party/protobuf/third_party" || return 1
	cp -a "${current_source_root}/third_party/protobuf/third_party/utf8_range" "${grpc_tools_root}/third_party/protobuf/third_party/" || return 1

	"${HOST_TOOLS_PYTHON}" - "${grpc_tools_root}/protoc_lib_deps.py" "${grpc_tools_root}" <<'PY'
import ast
import pathlib
import pprint
import sys

deps_path = pathlib.Path(sys.argv[1])
root = pathlib.Path(sys.argv[2])
module = ast.parse(deps_path.read_text())
assignments = {
    node.targets[0].id: node
    for node in module.body
    if isinstance(node, ast.Assign)
    and len(node.targets) == 1
    and isinstance(node.targets[0], ast.Name)
}
cc_node = assignments.get("CC_FILES")
if cc_node is None:
    raise SystemExit("CC_FILES not found in protoc_lib_deps.py")
cc_files = ast.literal_eval(cc_node.value)
missing = [path for path in cc_files if not (root / path).is_file()]
if missing:
    cc_files = [path for path in cc_files if path not in set(missing)]
    text = deps_path.read_text()
    start = cc_node.value.lineno - 1
    end = cc_node.value.end_lineno
    lines = text.splitlines()
    replacement = "CC_FILES=" + pprint.pformat(cc_files, indent=4, width=79)
    lines[start:end] = replacement.splitlines()
    deps_path.write_text("\n".join(lines) + "\n")
    print("Removed missing grpcio-tools sources:")
    for path in missing:
        print("  " + path)
PY
}
