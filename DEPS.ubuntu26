apt install -y lsb-release wget software-properties-common gnupg curl zstd
apt install -y build-essential file patchelf bison flex nasm texinfo perl automake autoconf autopoint libtool libtool-bin m4 po4a
# python deps
apt install -y gdb lcov pkg-config libbz2-dev libffi-dev liblzma-dev libncurses-dev libreadline-dev libsqlite3-dev libssl-dev lzma uuid-dev zlib1g-dev libmpdec-dev libzstd-dev inetutils-inetd python3-pip python3-venv
# scipy deps
apt install -y gfortran gfortran-aarch64-linux-gnu
# zstd deps
apt install -y ninja-build
# pypkgs deps
apt install -y git zip
# grpc host build
apt install -y cmake
# mesa deps
apt install -y glslang-tools
# fontconfig deps
apt install -y gperf
# openjdk deps: use same jdk version as bootstrap JDK; no libstdc++-12-dev to avoid using default glibc
apt install -y openjdk-21-jdk libc6-dev libc++-17-dev libc++abi-17-dev clang llvm lldb lld
# PyO3/rust packages deps: rust toolchain
curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
. "$HOME/.cargo/env"
