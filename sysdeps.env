#!/bin/sh
# DO NOT MOVE THIS FILE: this file must be placed under the parent installation directory on OHOS platform
# NOTE: source this file only under directory of the parent directory of this script
set -e
export HOME=/root
export SCRIPT_DIR=$(pwd)
if [ ! -d "${SCRIPT_DIR}/out" ]; then
    echo "ERROR: cannot find sysdeps in ${SCRIPT_DIR}/out"
else
export OHOS_SYSDEPS_ROOT=${SCRIPT_DIR}/out
export LD_LIBRARY_PATH=${SCRIPT_DIR}/install/lib:${OHOS_SYSDEPS_ROOT}/lib:${OHOS_SYSDEPS_ROOT}/plugins/platforms:$LD_LIBRARY_PATH
export PATH=${OHOS_SYSDEPS_ROOT}/bin:${OHOS_SYSDEPS_ROOT}/sbin:$PATH
export OPENSSL_MODULES=${SCRIPT_DIR}/out/lib/ossl-modules
export PYTHONHOME=${OHOS_SYSDEPS_ROOT}
export PYTHONPATH=${OHOS_SYSDEPS_ROOT}/lib
# setup vim
export VIMRUNTIME=${OHOS_SYSDEPS_ROOT}/share/vim/vim91
export TERMINFO_DIRS=${OHOS_SYSDEPS_ROOT}/share/terminfo
# setup sshd
if [ -f "${OHOS_SYSDEPS_ROOT}/etc/sshd_config" ]; then
    mount -o remount,rw /
    mkdir -p /var/empty /var/run /root/.ssh /libexec
    chmod 0555 /var/empty
    if [ ! -f "/etc/sshd_config" ]; then
        cp -r ${OHOS_SYSDEPS_ROOT}/etc/* /etc
	cp -r ${OHOS_SYSDEPS_ROOT}/libexec/* /libexec
        # setup /etc/passwd: use /root as the home of the root & /bin/sh as the shell of the root
        sed -i 's|root:x:0:0:::/bin/false|root:x:0:0::/root:/bin/sh|' /etc/passwd
        # permit root login
        sed -i 's|#PermitRootLogin .*|PermitRootLogin yes|' /etc/sshd_config
    fi
    # generate host keys for the first time
    if [ ! -f "/etc/ssh_host_rsa_key" ]; then
        ssh-keygen -A || true
    fi
fi
# setup java
export JAVA_HOME=${OHOS_SYSDEPS_ROOT}/local
export PATH=$PATH:${JAVA_HOME}/bin

fi

alias ll='ls -lah'

set +e

